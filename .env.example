# Copy to .env and fill in. NEVER commit .env. Claude Code must not read .env.

APP_ENV=local
DISPLAY_TZ=Asia/Singapore

# Local stack (docker compose defaults).
# These localhost URLs are for host runs (tests, alembic, scripts). Containers get their own
# addresses (db, redis, objectstore) from infra/docker-compose.yml, which overrides these.
# S3_* also set the local object store's root credentials (Silo, ADR-011).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/autotrading
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=raw-payloads

# SEC EDGAR — no key; a declared User-Agent is required: "Your Name your.email@example.com"
SEC_USER_AGENT=

# FRED / ALFRED — free API key from the FRED website
FRED_API_KEY=

# Alpaca Market Data (Basic, IEX) — ADR-004. Paper account keys only.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Massive — leave EMPTY until license check is recorded in DECISIONS.md (ADR-004)
MASSIVE_API_KEY=

# Phase 3+ (ADR-009, Accepted 2026-10-18; used from M3.1) — leave empty until then
ANTHROPIC_API_KEY=
LLM_MODEL=

# Telegram alert delivery (M3.0b, ADR-037): your own bot from @BotFather and your chat id
# (`make telegram-check` lists it). Leave empty to keep alerts in the app only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phase 4+ — leave empty
X_BEARER_TOKEN=

# Phase 5+ — DO NOT ADD broker credentials before Phase 5. Live credentials only after Phase 6 gates.
LIVE_TRADING_ENABLED=false
